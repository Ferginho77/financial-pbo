@model ErrorViewModel
@{
    ViewData["Title"] = Model.Title;
}

<div class="empty-state empty-state--page">
    <div class="empty-state__code">@Model.Code</div>
    <h1>@Model.Title</h1>
    <p>@Model.Message</p>
    @if (!string.IsNullOrEmpty(Model.RequestId))
    {
        <p class="muted small">Kode referensi: <code>@Model.RequestId</code></p>
    }
    <a class="btn btn--primary" asp-controller="Home" asp-action="Index">Kembali ke Dashboard</a>
</div>
